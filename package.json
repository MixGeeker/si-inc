{
  "name": "singularity-inc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": { "node": "^22.12.0 || >=24.0.0" },
  "scripts": {
    "predev": "npm run typecheck",
    "dev": "vite apps/web",
    "test": "node --experimental-strip-types --test",
    "sound:preview": "node --experimental-strip-types scripts/render_sound_preview.mjs",
    "typecheck": "tsrs -p tsconfig.json && tsrs -p apps/web/tsconfig.json && tsrs -p apps/api/tsconfig.json && tsrs -p tsconfig.tools.json",
    "build": "npm run typecheck && vite build apps/web",
    "preview": "vite preview apps/web"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261113.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "vite": "8.3.8"
  }
}
